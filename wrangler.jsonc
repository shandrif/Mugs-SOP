{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mugs-sop",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],

  // The existing site is served as static assets; only /api/* runs the Worker first.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Report metadata, branch history and review decisions.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mugs-sop",
      "database_id": "d49eb71f-940d-42fd-be94-67331f949226",
      "migrations_dir": "migrations"
    }
  ],

  // Original uploaded files and parsed sale lines.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "mugs-sop-files" }
  ],

  // Daily clean-up of reports older than RETENTION_DAYS (03:17 UTC).
  "triggers": { "crons": ["17 3 * * *"] },

  "vars": {
    "RETENTION_DAYS": "90",
    // "access" verifies the Cloudflare Access login on every API call.
    // Set ACCESS_TEAM_DOMAIN (e.g. https://halfmillion.cloudflareaccess.com) and ACCESS_AUD after creating the Access app.
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  },

  // Local development: `npm run dev` uses local D1/R2 and skips the Access check.
  "env": {}
}
